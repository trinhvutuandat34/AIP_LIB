{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Combat 에이전트 트리",
  "description": "자동 생성(scripts/gen_references.py) — 수정 금지. 코드가 단일 진실. 에디터 검증은 보조 — 최종 판정은 tools/validate_agent.py.",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "리플레이(ACMI CallSign) 표시용 이름"
    },
    "dwell_s": {
      "type": "number",
      "minimum": 0,
      "description": "명령 히스테리시스 최소 유지시간 [s] (기본 0.3). 0 이면 매 tick 즉시 전환"
    },
    "doctrine": {
      "type": "object",
      "properties": {
        "corner_kcas_lo": {
          "type": "number",
          "minimum": 330.0,
          "maximum": 440.0
        },
        "corner_kcas_hi": {
          "type": "number",
          "minimum": 330.0,
          "maximum": 440.0
        },
        "fighting_kts_lo": {
          "type": "number",
          "minimum": 325.0,
          "maximum": 375.0
        },
        "fighting_kts_hi": {
          "type": "number",
          "minimum": 325.0,
          "maximum": 375.0
        },
        "energy_margin_lo": {
          "type": "number",
          "minimum": 50.0,
          "maximum": 75.0
        },
        "energy_margin_hi": {
          "type": "number",
          "minimum": 50.0,
          "maximum": 75.0
        },
        "slant_ft_lo": {
          "type": "number",
          "minimum": 4000.0,
          "maximum": 6000.0
        },
        "slant_ft_hi": {
          "type": "number",
          "minimum": 4000.0,
          "maximum": 6000.0
        },
        "ata_target_lo": {
          "type": "number",
          "minimum": 35.0,
          "maximum": 50.0
        },
        "ata_target_hi": {
          "type": "number",
          "minimum": 35.0,
          "maximum": 50.0
        },
        "entry_kcas": {
          "type": "number",
          "minimum": 450.0,
          "maximum": 480.0
        },
        "lv_above_ft": {
          "type": "number",
          "minimum": 500.0,
          "maximum": 1000.0
        },
        "initial_pull_g": {
          "type": "number",
          "minimum": 6.0,
          "maximum": 8.0
        },
        "g_fraction": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 0.95
        },
        "g_min": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1.5
        },
        "initial_pull_aspect_deg": {
          "type": "number",
          "minimum": 90.0,
          "maximum": 150.0
        },
        "closure_saddle_ft": {
          "type": "number",
          "minimum": 600.0,
          "maximum": 1500.0
        },
        "energy_backoff_floor": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 0.8
        },
        "cz_close_t_s": {
          "type": "number",
          "minimum": 2.0,
          "maximum": 8.0
        }
      },
      "additionalProperties": false,
      "description": "L2 교리 setpoint 오버라이드 — 개방 — 교범 대역 내 조정"
    },
    "selector": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      },
      "minItems": 1,
      "description": "처음 성공하는 자식 채택 (우선순위 폴백)"
    },
    "sequence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      },
      "minItems": 1,
      "description": "전부 성공해야 성공 (조건 게이트→액션)"
    },
    "condition": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "foe_threat",
            "overshoot_risk",
            "foe_extending",
            "in_gun_envelope",
            "nose_far",
            "energy_advantage",
            "low_altitude",
            "foe_above",
            "foe_below",
            "behind_foe",
            "in_control_zone",
            "merged",
            "one_circle",
            "two_circle",
            "closing",
            "below_fighting_speed",
            "above_fighting_speed",
            "low_health",
            "vel_nose_far",
            "foe_path_threat",
            "is_head_on",
            "is_offensive",
            "is_defensive",
            "in_overtime"
          ],
          "description": "기본 임계값으로 사용"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "foe_threat",
              "description": "적이 내 정면(헤드온)에서 조준 중 — 방어 국면. (aspect≈180 = 적 12시에 나)"
            },
            "aspect_deg": {
              "type": "number",
              "default": 120.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "overshoot_risk",
              "description": "빠른 접근 + 근거리 → 추월 위험. lag/요요로 물러서야 함(4.4.7.2)."
            },
            "closure_fps": {
              "type": "number",
              "default": 150.0
            },
            "range_ft": {
              "type": "number",
              "default": 2000.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "foe_extending",
              "description": "적이 멀어지며 거리 벌림 → max-G 리드 추격(4.4.8.2.1)."
            },
            "closure_fps": {
              "type": "number",
              "default": 0.0
            },
            "range_ft": {
              "type": "number",
              "default": 6000.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "in_gun_envelope",
              "description": "건 사거리 + 조준각 근접 → pure/추적."
            },
            "range_ft": {
              "type": "number",
              "default": 3000.0
            },
            "ata_deg": {
              "type": "number",
              "default": 30.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "nose_far",
              "description": "기수가 적에서 크게 벗어남 → 리드로 기수 당김."
            },
            "ata_deg": {
              "type": "number",
              "default": 60.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "energy_advantage",
              "description": "비에너지 우세 → 공세 유지 가능."
            },
            "min_ft": {
              "type": "number",
              "default": 0.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "low_altitude",
              "description": "하드덱(1,000ft) 근접 — 즉시 회복 필요. 급강하 관성 때문에 대응이 늦으면 회복해도 하드덱을 뚫는다 → floor_ft 는 넉넉한 여유를 둔다(기본 4,000ft). lookahead_s 를 주면 현재 고도 대신 그만큼 뒤의 예상 고도로 판정한다(기본 0=현재 고도). 고도만 보면 강하각에 따라 여유가 달라진다 — 730fps 강하에서 4,500ft 는 6초뿐인데 60° 강하 회복에는 4,500ft 가 든다. lookahead_s 는 침하율에 비례해 트리거를 앞당기므로 수평비행에서는 기본과 동일하게 동작한다."
            },
            "floor_ft": {
              "type": "number",
              "default": 4000.0
            },
            "lookahead_s": {
              "type": "number",
              "default": 0.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "foe_above",
              "description": "적이 나보다 위 — 수직 분리 판정(4.4.10). alt_gap_ft 양수=적이 위."
            },
            "min_ft": {
              "type": "number",
              "default": 500.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "foe_below",
              "description": "적이 나보다 아래 — 요요 정점(재강하 시점) 판정(4.4.6.2.3)."
            },
            "min_ft": {
              "type": "number",
              "default": 500.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "behind_foe",
              "description": "적 후방 반구(control zone) 점유 — 공세 국면 판정(4.4.6)."
            },
            "aspect_deg": {
              "type": "number",
              "default": 60.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "in_control_zone",
              "description": "BEM control zone 점유 — 후방 2~3 kft + AA≈0 + HCA 정렬(4.4.6). ATA 20~30°는 조건이 아니라 lag 추격의 결과(존 유지 기동이 만드는 기하)."
            },
            "range_lo_ft": {
              "type": "number",
              "default": 2000.0
            },
            "range_hi_ft": {
              "type": "number",
              "default": 3000.0
            },
            "aspect_deg": {
              "type": "number",
              "default": 30.0
            },
            "hca_deg": {
              "type": "number",
              "default": 30.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "merged",
              "description": "merge 통과(초근접) — 넥타이/교차 직후 국면(4.4.4)."
            },
            "range_ft": {
              "type": "number",
              "default": 1500.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "one_circle",
              "description": "1-circle flow — 양 기체가 **반대 수평 선회방향**으로 원 하나를 공유(radius fight). 한쪽이라도 직선이면 False. BEM 4.4.4 flow 정의 — 구 순간 HCA<90 프록시에서 2026-07-17 교범 정합 전환. 2-circle 은 two_circle 조건(inverter 아님 — 직선 포함 문제)."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "two_circle",
              "description": "2-circle flow — 양 기체가 **같은 수평 회전방향**(노즈-투-노즈 rate fight). 한쪽이라도 직선이면 False. BEM 4.4.4. ¬one_circle 과 다름 — inverter 는 둘 다 직선인 접근 국면까지 참이 되므로 flow 판별에는 이 조건을 쓸 것."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "closing",
              "description": "유의미한 접근율 — 요요 국면 전환(진입/정점) 판정."
            },
            "min_fps": {
              "type": "number",
              "default": 100.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "below_fighting_speed",
              "description": "파이팅 속도 하한 미만 — 에너지 회복 필요(4.4.6.2.2). 기본값=교리 fighting_kts_lo."
            },
            "kcas": {
              "type": "number"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "above_fighting_speed",
              "description": "파이팅 속도 상한 초과 — 에너지 여유(전환 기동 가능)(4.4.6.2.2). 기본값=교리 fighting_kts_hi."
            },
            "kcas": {
              "type": "number"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "low_health",
              "description": "내 잔여 HP 가 임계 미만 — 손상 국면 전환(방어 전환·이탈 판단) 판정."
            },
            "hp": {
              "type": "number",
              "default": 40.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "vel_nose_far",
              "description": "내 속도벡터가 적에서 크게 벗어남 — nose_far 의 속도벡터판. 기수는 표적을 물었는데 비행경로가 흘러나가는 고AoA 드리프트 감지."
            },
            "vel_ata_deg": {
              "type": "number",
              "default": 60.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "foe_path_threat",
              "description": "적 속도벡터(비행경로)가 나를 향함 — foe_threat 의 속도벡터판. 기수 조준(aspect)보다 실제 접근 경로 기반의 위협 판정."
            },
            "vel_aa_deg": {
              "type": "number",
              "default": 120.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "is_head_on",
              "description": "HABFM — 종축이 대향(HCA 고, BEM Angle-Off): 머지/헤드온 국면(4.4.4). 안정 노즈온 추적 대상."
            },
            "hca_deg": {
              "type": "number",
              "default": 150.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "is_offensive",
              "description": "OBFM — 내가 적 후미(aspect 낮음): 공세 국면(4.4.6). control zone 유지 대상."
            },
            "aspect_deg": {
              "type": "number",
              "default": 60.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "is_defensive",
              "description": "DBFM — 적이 내 후미(aspect 높음): 방어 국면(4.4.9). 브레이크/역전 대상."
            },
            "aspect_deg": {
              "type": "number",
              "default": 120.0
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "in_overtime",
              "description": "오버타임 구간 — 정규 300초에 승자가 안 나온 현장 단판의 연장 120초. OT 에서는 Gun WEZ 가 완화된다(사거리 6,000 ft, 원뿔 45°). 이 조건으로 분기해 OT 전용 사격·추격 임계를 쓰라 — 예: {condition: in_overtime} + {condition: {name: in_gun_envelope, range_ft: 6000, ata_deg: 45}} 적용 범위는 현장 단판뿐이다(훈련센터·예선 풀리그는 항상 False)."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "pursuit": {
          "enum": [
            "lag",
            "lead",
            "pure"
          ],
          "description": "추격 기하 — lead(앞 조준)/pure(현 위치)/lag(뒤)"
        },
        "name": {
          "type": "string",
          "description": "Tacview ActiveNode 전술명"
        },
        "mode": {
          "enum": [
            "control_zone",
            "stable"
          ],
          "description": "L2 가이드 모드 — stable(헤드온 안정)/control_zone(존 유지)"
        },
        "aim_above_ft": {
          "type": "number",
          "minimum": -5000.0,
          "maximum": 5000.0,
          "description": "조준점 수직 오프셋 [ft] (+위/−아래)"
        },
        "lead_time_s": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 3.0,
          "description": "lead 예측시간 오버라이드 [s]"
        },
        "lag_dist_ft": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 8000.0,
          "description": "lag 후방거리 오버라이드 [ft]"
        },
        "cz_range_ft": {
          "type": "number",
          "minimum": 500.0,
          "maximum": 6000.0,
          "description": "control_zone 목표거리 [ft]"
        },
        "g_burst": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "지속↔순간 봉투 보간 = 지령 G 천장 (0=에너지 보존, 1=순간 봉투 전량)"
        },
        "g_full_ata_deg": {
          "type": "number",
          "minimum": 20.0,
          "maximum": 90.0,
          "description": "명목 G 에 포화하는 ATA [deg] — 작을수록 공격적"
        },
        "track_rng_ft": {
          "type": "number",
          "minimum": 1000.0,
          "maximum": 3000.0,
          "description": "건 추적 하한 G 발동 사거리 [ft]"
        },
        "track_ata_deg": {
          "type": "number",
          "minimum": 10.0,
          "maximum": 30.0,
          "description": "건 추적 하한 G 발동 ATA [deg]"
        }
      },
      "required": [
        "pursuit"
      ],
      "additionalProperties": false
    },
    "inverter": {
      "$ref": "#/definitions/node"
    },
    "commit": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "child": {
          "$ref": "#/definitions/node"
        },
        "duration_s": {
          "type": "number",
          "default": 4.0
        },
        "cooldown_s": {
          "type": "number",
          "default": 0.0
        }
      },
      "required": [
        "child"
      ],
      "additionalProperties": false
    },
    "cooldown": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "child": {
          "$ref": "#/definitions/node"
        },
        "wait_s": {
          "type": "number",
          "default": 5.0
        }
      },
      "required": [
        "child"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "selector"
      ]
    },
    {
      "required": [
        "sequence"
      ]
    },
    {
      "required": [
        "condition"
      ]
    },
    {
      "required": [
        "action"
      ]
    },
    {
      "required": [
        "inverter"
      ]
    },
    {
      "required": [
        "commit"
      ]
    },
    {
      "required": [
        "cooldown"
      ]
    }
  ],
  "definitions": {
    "node": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          },
          "minItems": 1,
          "description": "처음 성공하는 자식 채택 (우선순위 폴백)"
        },
        "sequence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          },
          "minItems": 1,
          "description": "전부 성공해야 성공 (조건 게이트→액션)"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "foe_threat",
                "overshoot_risk",
                "foe_extending",
                "in_gun_envelope",
                "nose_far",
                "energy_advantage",
                "low_altitude",
                "foe_above",
                "foe_below",
                "behind_foe",
                "in_control_zone",
                "merged",
                "one_circle",
                "two_circle",
                "closing",
                "below_fighting_speed",
                "above_fighting_speed",
                "low_health",
                "vel_nose_far",
                "foe_path_threat",
                "is_head_on",
                "is_offensive",
                "is_defensive",
                "in_overtime"
              ],
              "description": "기본 임계값으로 사용"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "foe_threat",
                  "description": "적이 내 정면(헤드온)에서 조준 중 — 방어 국면. (aspect≈180 = 적 12시에 나)"
                },
                "aspect_deg": {
                  "type": "number",
                  "default": 120.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "overshoot_risk",
                  "description": "빠른 접근 + 근거리 → 추월 위험. lag/요요로 물러서야 함(4.4.7.2)."
                },
                "closure_fps": {
                  "type": "number",
                  "default": 150.0
                },
                "range_ft": {
                  "type": "number",
                  "default": 2000.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "foe_extending",
                  "description": "적이 멀어지며 거리 벌림 → max-G 리드 추격(4.4.8.2.1)."
                },
                "closure_fps": {
                  "type": "number",
                  "default": 0.0
                },
                "range_ft": {
                  "type": "number",
                  "default": 6000.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "in_gun_envelope",
                  "description": "건 사거리 + 조준각 근접 → pure/추적."
                },
                "range_ft": {
                  "type": "number",
                  "default": 3000.0
                },
                "ata_deg": {
                  "type": "number",
                  "default": 30.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "nose_far",
                  "description": "기수가 적에서 크게 벗어남 → 리드로 기수 당김."
                },
                "ata_deg": {
                  "type": "number",
                  "default": 60.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "energy_advantage",
                  "description": "비에너지 우세 → 공세 유지 가능."
                },
                "min_ft": {
                  "type": "number",
                  "default": 0.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "low_altitude",
                  "description": "하드덱(1,000ft) 근접 — 즉시 회복 필요. 급강하 관성 때문에 대응이 늦으면 회복해도 하드덱을 뚫는다 → floor_ft 는 넉넉한 여유를 둔다(기본 4,000ft). lookahead_s 를 주면 현재 고도 대신 그만큼 뒤의 예상 고도로 판정한다(기본 0=현재 고도). 고도만 보면 강하각에 따라 여유가 달라진다 — 730fps 강하에서 4,500ft 는 6초뿐인데 60° 강하 회복에는 4,500ft 가 든다. lookahead_s 는 침하율에 비례해 트리거를 앞당기므로 수평비행에서는 기본과 동일하게 동작한다."
                },
                "floor_ft": {
                  "type": "number",
                  "default": 4000.0
                },
                "lookahead_s": {
                  "type": "number",
                  "default": 0.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "foe_above",
                  "description": "적이 나보다 위 — 수직 분리 판정(4.4.10). alt_gap_ft 양수=적이 위."
                },
                "min_ft": {
                  "type": "number",
                  "default": 500.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "foe_below",
                  "description": "적이 나보다 아래 — 요요 정점(재강하 시점) 판정(4.4.6.2.3)."
                },
                "min_ft": {
                  "type": "number",
                  "default": 500.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "behind_foe",
                  "description": "적 후방 반구(control zone) 점유 — 공세 국면 판정(4.4.6)."
                },
                "aspect_deg": {
                  "type": "number",
                  "default": 60.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "in_control_zone",
                  "description": "BEM control zone 점유 — 후방 2~3 kft + AA≈0 + HCA 정렬(4.4.6). ATA 20~30°는 조건이 아니라 lag 추격의 결과(존 유지 기동이 만드는 기하)."
                },
                "range_lo_ft": {
                  "type": "number",
                  "default": 2000.0
                },
                "range_hi_ft": {
                  "type": "number",
                  "default": 3000.0
                },
                "aspect_deg": {
                  "type": "number",
                  "default": 30.0
                },
                "hca_deg": {
                  "type": "number",
                  "default": 30.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "merged",
                  "description": "merge 통과(초근접) — 넥타이/교차 직후 국면(4.4.4)."
                },
                "range_ft": {
                  "type": "number",
                  "default": 1500.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "one_circle",
                  "description": "1-circle flow — 양 기체가 **반대 수평 선회방향**으로 원 하나를 공유(radius fight). 한쪽이라도 직선이면 False. BEM 4.4.4 flow 정의 — 구 순간 HCA<90 프록시에서 2026-07-17 교범 정합 전환. 2-circle 은 two_circle 조건(inverter 아님 — 직선 포함 문제)."
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "two_circle",
                  "description": "2-circle flow — 양 기체가 **같은 수평 회전방향**(노즈-투-노즈 rate fight). 한쪽이라도 직선이면 False. BEM 4.4.4. ¬one_circle 과 다름 — inverter 는 둘 다 직선인 접근 국면까지 참이 되므로 flow 판별에는 이 조건을 쓸 것."
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "closing",
                  "description": "유의미한 접근율 — 요요 국면 전환(진입/정점) 판정."
                },
                "min_fps": {
                  "type": "number",
                  "default": 100.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "below_fighting_speed",
                  "description": "파이팅 속도 하한 미만 — 에너지 회복 필요(4.4.6.2.2). 기본값=교리 fighting_kts_lo."
                },
                "kcas": {
                  "type": "number"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "above_fighting_speed",
                  "description": "파이팅 속도 상한 초과 — 에너지 여유(전환 기동 가능)(4.4.6.2.2). 기본값=교리 fighting_kts_hi."
                },
                "kcas": {
                  "type": "number"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "low_health",
                  "description": "내 잔여 HP 가 임계 미만 — 손상 국면 전환(방어 전환·이탈 판단) 판정."
                },
                "hp": {
                  "type": "number",
                  "default": 40.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "vel_nose_far",
                  "description": "내 속도벡터가 적에서 크게 벗어남 — nose_far 의 속도벡터판. 기수는 표적을 물었는데 비행경로가 흘러나가는 고AoA 드리프트 감지."
                },
                "vel_ata_deg": {
                  "type": "number",
                  "default": 60.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "foe_path_threat",
                  "description": "적 속도벡터(비행경로)가 나를 향함 — foe_threat 의 속도벡터판. 기수 조준(aspect)보다 실제 접근 경로 기반의 위협 판정."
                },
                "vel_aa_deg": {
                  "type": "number",
                  "default": 120.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "is_head_on",
                  "description": "HABFM — 종축이 대향(HCA 고, BEM Angle-Off): 머지/헤드온 국면(4.4.4). 안정 노즈온 추적 대상."
                },
                "hca_deg": {
                  "type": "number",
                  "default": 150.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "is_offensive",
                  "description": "OBFM — 내가 적 후미(aspect 낮음): 공세 국면(4.4.6). control zone 유지 대상."
                },
                "aspect_deg": {
                  "type": "number",
                  "default": 60.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "is_defensive",
                  "description": "DBFM — 적이 내 후미(aspect 높음): 방어 국면(4.4.9). 브레이크/역전 대상."
                },
                "aspect_deg": {
                  "type": "number",
                  "default": 120.0
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "const": "in_overtime",
                  "description": "오버타임 구간 — 정규 300초에 승자가 안 나온 현장 단판의 연장 120초. OT 에서는 Gun WEZ 가 완화된다(사거리 6,000 ft, 원뿔 45°). 이 조건으로 분기해 OT 전용 사격·추격 임계를 쓰라 — 예: {condition: in_overtime} + {condition: {name: in_gun_envelope, range_ft: 6000, ata_deg: 45}} 적용 범위는 현장 단판뿐이다(훈련센터·예선 풀리그는 항상 False)."
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          ]
        },
        "action": {
          "type": "object",
          "properties": {
            "pursuit": {
              "enum": [
                "lag",
                "lead",
                "pure"
              ],
              "description": "추격 기하 — lead(앞 조준)/pure(현 위치)/lag(뒤)"
            },
            "name": {
              "type": "string",
              "description": "Tacview ActiveNode 전술명"
            },
            "mode": {
              "enum": [
                "control_zone",
                "stable"
              ],
              "description": "L2 가이드 모드 — stable(헤드온 안정)/control_zone(존 유지)"
            },
            "aim_above_ft": {
              "type": "number",
              "minimum": -5000.0,
              "maximum": 5000.0,
              "description": "조준점 수직 오프셋 [ft] (+위/−아래)"
            },
            "lead_time_s": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 3.0,
              "description": "lead 예측시간 오버라이드 [s]"
            },
            "lag_dist_ft": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 8000.0,
              "description": "lag 후방거리 오버라이드 [ft]"
            },
            "cz_range_ft": {
              "type": "number",
              "minimum": 500.0,
              "maximum": 6000.0,
              "description": "control_zone 목표거리 [ft]"
            },
            "g_burst": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "description": "지속↔순간 봉투 보간 = 지령 G 천장 (0=에너지 보존, 1=순간 봉투 전량)"
            },
            "g_full_ata_deg": {
              "type": "number",
              "minimum": 20.0,
              "maximum": 90.0,
              "description": "명목 G 에 포화하는 ATA [deg] — 작을수록 공격적"
            },
            "track_rng_ft": {
              "type": "number",
              "minimum": 1000.0,
              "maximum": 3000.0,
              "description": "건 추적 하한 G 발동 사거리 [ft]"
            },
            "track_ata_deg": {
              "type": "number",
              "minimum": 10.0,
              "maximum": 30.0,
              "description": "건 추적 하한 G 발동 ATA [deg]"
            }
          },
          "required": [
            "pursuit"
          ],
          "additionalProperties": false
        },
        "inverter": {
          "$ref": "#/definitions/node"
        },
        "commit": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "child": {
              "$ref": "#/definitions/node"
            },
            "duration_s": {
              "type": "number",
              "default": 4.0
            },
            "cooldown_s": {
              "type": "number",
              "default": 0.0
            }
          },
          "required": [
            "child"
          ],
          "additionalProperties": false
        },
        "cooldown": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "child": {
              "$ref": "#/definitions/node"
            },
            "wait_s": {
              "type": "number",
              "default": 5.0
            }
          },
          "required": [
            "child"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1
    }
  }
}
