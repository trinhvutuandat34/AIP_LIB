# Stale Windows installers (not project source, don't belong in the repo)
Anaconda3-*.exe
VSCodeUserSetup-*.exe
*.lnk

# Build output / IDE cache (regeneratable from source)
**/.vs/
**/Debug/
**/x64/
build/CMakeFiles/
build/CMakeCache.txt
bin/
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Python
**/__pycache__/
*.pyc

# Vendored packaged Unreal builds (binaries only, no source, ~1GB — see
# CLAUDE.md; re-obtain from competition organizers rather than tracking here)
Windows/

# Training/eval run output (regeneratable, large file counts under artifacts/curriculum
# and artifacts/ray_results in particular — don't let these hang `git add -A`)
DogFightEnv/Release/artifacts/
DogFightEnv/Release/logs/
*.log
*.bak
*.bak_*
